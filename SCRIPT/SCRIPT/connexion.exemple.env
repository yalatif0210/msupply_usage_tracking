# Connexion à la base mSupply pour lancer_extraction.sh.
# Copier ce fichier en « connexion.env », dans le même dossier, puis remplacer
# les valeurs. À faire une seule fois.
#
# JAMAIS de mot de passe ici : il est demandé à chaque lancement du script et
# n'est enregistré nulle part.

PGHOST=nom-ou-adresse-du-serveur
PGPORT=5432
PGDATABASE=nom-de-la-base-msupply
PGUSER=compte-en-lecture-seule
