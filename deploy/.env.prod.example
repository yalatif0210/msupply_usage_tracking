# Configuration de production — copier en `deploy/.env.prod` et renseigner.
# `deploy/.env.prod` est ignoré par git (secrets). Ne jamais le committer.
#
#   cp deploy/.env.prod.example deploy/.env.prod
#   $EDITOR deploy/.env.prod
#   docker compose --env-file deploy/.env.prod -f docker-compose.prod.yml up -d

# ── Domaine et TLS ────────────────────────────────────────────────────────
# Nom de domaine public qui pointe (enregistrement A / AAAA) vers ce serveur.
# Les ports 80 et 443 doivent être joignables depuis Internet pour Let's Encrypt.
DQA_DOMAIN=dqa.exemple.org
# Adresse de contact pour Let's Encrypt (expiration de certificat, incidents).
DQA_ACME_EMAIL=exploitation@exemple.org
# `1` = serveur de test Let's Encrypt (quota large, certificat non reconnu par
# les navigateurs). Utiliser `1` pour les essais, repasser à `0` pour de vrai.
DQA_ACME_STAGING=0

# ── Fuseau horaire ───────────────────────────────────────────────────────
# Fuseau des conteneurs base + API. La Côte d'Ivoire est à UTC+0 sans heure
# d'été. Détermine ce que valent `CURRENT_DATE` / `now()` côté PostgreSQL
# (clôture de mois P2, compteur P3).
DQA_TZ=Africa/Abidjan

# ── Base de données ──────────────────────────────────────────────────────
POSTGRES_USER=dqa
# GÉNÉRER une valeur forte : `openssl rand -base64 24`
POSTGRES_PASSWORD=a-changer-imperativement
POSTGRES_DB=dqa

# ── Sauvegardes ──────────────────────────────────────────────────────────
# Nombre de jours de rétention des dumps dans `./backups/`.
DQA_BACKUP_RETENTION_DAYS=14
