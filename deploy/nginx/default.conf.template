# ─────────────────────────────────────────────────────────────────────────
#  Gabarit Nginx de production (tableau de bord DQA mSupply).
#
#  `${DQA_DOMAIN}` est remplacé UNE FOIS au démarrage du conteneur par
#  `envsubst` (entrypoint de l'image nginx) à partir de la variable
#  d'environnement du même nom. Le fichier produit devient
#  /etc/nginx/conf.d/default.conf et remplace la config bakée dans l'image.
#
#  Toutes les autres `$...` (`$host`, `$uri`, `$scheme`...) sont des variables
#  NGINX évaluées à chaque requête — ne pas les mettre entre accolades.
#
#  Chaque directive est expliquée dans docs/manuel_deploiement.md §4.
# ─────────────────────────────────────────────────────────────────────────

# Résolveur DNS interne de Docker (toujours 127.0.0.11 sur un réseau Compose).
# Permet de re-résoudre `api` si son conteneur redémarre avec une autre IP,
# au lieu de figer l'adresse au démarrage de Nginx.
resolver 127.0.0.11 valid=30s ipv6=off;

# ══ HTTP (port 80) : challenge ACME + redirection permanente vers HTTPS ═══
server {
    listen 80;
    server_name ${DQA_DOMAIN};

    # Let's Encrypt écrit ici le jeton de validation HTTP-01 (volume partagé
    # avec le service `certbot`).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Tout le reste bascule en HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
}

# ══ HTTPS (port 443) : l'application ════════════════════════════════════
server {
    listen 443 ssl;
    http2 on;
    server_name ${DQA_DOMAIN};

    # Certificats Let's Encrypt (volume `certbot_certs`, renouvelés par le
    # service `certbot`, rechargés par le hook 99-reload.sh).
    ssl_certificate         /etc/letsencrypt/live/${DQA_DOMAIN}/fullchain.pem;
    ssl_certificate_key     /etc/letsencrypt/live/${DQA_DOMAIN}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${DQA_DOMAIN}/chain.pem;

    # Politique TLS : uniquement 1.2 et 1.3, suites AEAD modernes.
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache         shared:TLS:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # OCSP stapling : Nginx joint la preuve de non-révocation à la poignée de
    # main, le navigateur n'a pas à contacter l'autorité de certification.
    ssl_stapling        on;
    ssl_stapling_verify  on;

    root  /usr/share/nginx/html;
    index index.html;

    # Compression à la volée du texte (les .woff2 / images sont déjà compressés).
    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_types      text/plain text/css application/json application/javascript
                    application/manifest+json image/svg+xml application/wasm;

    # Un classeur d'extraction fait quelques Mo : relever la limite du corps.
    client_max_body_size 32m;

    # En-têtes de sécurité au niveau serveur : couvrent /api/ et les erreurs.
    include /etc/nginx/snippets/security-headers.conf;

    # ── API : reverse-proxy vers le conteneur `api` (port interne 3000) ──
    location /api/ {
        set $upstream http://api:3000;
        proxy_pass                 $upstream;
        proxy_http_version         1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout   300s;   # gel + reconstruction des vues à l'import
        proxy_send_timeout   300s;
    }

    # ── Actifs hachés (Angular outputHashing:all) : cache immuable ──────
    # Ce bloc pose son propre `add_header` -> il faut ré-inclure les en-têtes
    # de sécurité, Nginx n'hérite pas des `add_header` du bloc parent.
    location ~* \.(?:js|css|woff2?|ttf|eot|png|svg|jpe?g|gif|ico|webp)$ {
        include /etc/nginx/snippets/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # ── SPA Angular : toute route inconnue rejoue index.html ────────────
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
